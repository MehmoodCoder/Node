<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>URL Shortener</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: rgba(30, 41, 59, 0.7);
      --accent-color: #6366f1;
      --accent-hover: #4f46e5;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: rgba(255, 255, 255, 0.1);
      --success-bg: rgba(34, 197, 94, 0.15);
      --success-text: #86efac;
      --success-border: rgba(34, 197, 94, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background: radial-gradient(circle at top left, #1e1b4b, var(--bg-color));
      color: var(--text-main);
      padding: 2.5rem 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    h1 {
      margin-bottom: 1.5rem;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      text-align: center;
      background: linear-gradient(to right, #ffffff, var(--text-muted));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--text-main);
    }

    .card {
      background: var(--card-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      padding: 1.75rem;
      border-radius: 16px;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
      width: 100%;
      max-width: 800px;
      margin-bottom: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: row;
      gap: 12px;
    }

    input[type="url"] {
      flex: 1;
      padding: 0.85rem 1rem;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      color: var(--text-main);
      font-size: 0.95rem;
      outline: none;
      transition: all 0.2s ease;
      min-width: 0;
    }

    input[type="url"]:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    input[type="url"]::placeholder {
      color: var(--text-muted);
      opacity: 0.7;
    }

    button {
      padding: 0.85rem 1.5rem;
      background-color: var(--accent-color);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    button:hover {
      background-color: var(--accent-hover);
      transform: translateY(-1px);
    }

    button:active {
      transform: translateY(0);
    }

    .alert-success {
      width: 100%;
      max-width: 800px;
      background: var(--success-bg);
      border: 1px solid var(--success-border);
      color: var(--success-text);
      padding: 1rem 1.25rem;
      border-radius: 12px;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      text-align: center;
      word-break: break-all;
    }

    .alert-success a {
      color: #ffffff;
      font-weight: 700;
      text-decoration: underline;
      margin-left: 0.25rem;
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 10px;
      border: 1px solid var(--border-color);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 500px;
      background: rgba(15, 23, 42, 0.3);
    }

    th,
    td {
      text-align: left;
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.9rem;
    }

    th {
      background-color: rgba(15, 23, 42, 0.7);
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background-color: rgba(255, 255, 255, 0.02);
    }

    a {
      color: var(--accent-color);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    a:hover {
      text-decoration: underline;
    }

    .url-cell {
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--text-muted);
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      background: rgba(99, 102, 241, 0.15);
      color: var(--accent-color);
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.8rem;
    }

    .empty-state {
      color: var(--text-muted);
      font-size: 0.9rem;
      padding: 1rem 0;
      text-align: center;
    }

    @media (max-width: 600px) {
      body {
        padding: 1.5rem 0.75rem;
      }

      .card {
        padding: 1.25rem;
      }

      .form-group {
        flex-direction: column;
      }

      button {
        width: 100%;
      }

      .url-cell {
        max-width: 130px;
      }
    }
  </style>
</head>

<body>
  <h1>URL Shortener</h1>

  <div class="card">
    <form action="/url" method="POST" class="form-group">
      <input type="url" name="url" placeholder="https://example.com" required />
      <button type="submit">Generate Link</button>
    </form>
  </div>

  <% if (locals.id && locals.urls && urls.length > 0) { %>
    <div class="alert-success">
      ✨ URL Generated Successfully:
      <a href="/url/<%= id %>" target="_blank">
        http://localhost:4000/url/<%= id %>
      </a>
    </div>
  <% } %>

  <div class="card">
    <h2>All Generated Short URLs</h2>

    <% if (locals.urls && urls.length > 0) { %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>S.No</th>
              <th>Short ID</th>
              <th>Original URL</th>
              <th>Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach((url, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <a href="/url/<%= url.shortID %>" target="_blank">
                    <%= url.shortID %>
                  </a>
                </td>
                <td class="url-cell" title="<%= url.redirectURL %>">
                  <%= url.redirectURL %>
                </td>
                <td>
                  <span class="badge"><%= url.visitHistory.length %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="empty-state">No URLs generated yet. Enter a link above to get started!</p>
    <% } %>
  </div>
</body>

</html>